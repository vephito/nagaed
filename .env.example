# Copy this file to .env before running docker compose up.
MYSQL_DATABASE=nagaed
MYSQL_USER=nagaed
MYSQL_PASSWORD=local-demo-password
MYSQL_ROOT_PASSWORD=local-demo-root-password

# Ports exposed on your computer.
PORT=3000
FRONTEND_PORT=8080
AI_PORT=8000
# Local demo JWT secret.
JWT_SECRET=replace-this-with-a-long-random-secret

# A private Groq key is needed for AI username suggestions.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
